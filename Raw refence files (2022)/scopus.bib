@CONFERENCE{Mosqueira-Rey20201340,
author={Mosqueira-Rey, E. and Alonso-Ríos, D.},
title={Usability heuristics for domain-specific languages (DSLs)},
journal={Proceedings of the ACM Symposium on Applied Computing},
year={2020},
pages={1340-1343},
doi={10.1145/3341105.3374234},
note={cited By 4; Conference of 35th Annual ACM Symposium on Applied Computing, SAC 2020 ; Conference Date: 30 March 2020 Through 3 April 2020;  Conference Code:158685},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85083041033&doi=10.1145%2f3341105.3374234&partnerID=40&md5=7366fcc807d1fdd45893f36ce85cd991},
abstract={The usability of Domain-Specific Languages (DSLs) has been attracting considerable interest from researchers lately. In particular, our literature review found many usability studies that make use of subjective and empirical methods. However, we noted a lack of heuristic methods in the literature. In comparison, there exist several usability studies of Application Programming Interfaces (APIs) that have used heuristics with success, so we argue that this approach would be also useful for DSLs. Therefore, this paper proposes a set of usability heuristics for DSLs and illustrates the approach with a case study. We show how our heuristics helped us identify many actual usability problems, even for a simple DSL. © 2020 Owner/Author.},
references={Alonso-Ríos, D., Mosqueira-Rey, E., Moret-Bonillo, V., A systematic and generalizable approach to the heuristic evaluation of user interfaces (2018) International Journal of Human-Computer Interaction, 34 (12), pp. 1169-1182. , https://doi.org/10.1080/10447318.2018.1424101; Alonso-Ríos, D., Vázquez-García, A., Mosqueira-Rey, E., Moret-Bonillo, V., Usability: A critical analysis and a taxonomy (2009) International Journal of Human-Computer Interaction, 26 (1), pp. 53-74; Bariši, A., Amaral, V., Goulão, M., Usability driven DSL development with use-me (2018) Comp. Lang., Systems & Structures, 51, pp. 118-157; Bariši, A., Amaral, V., Goulao, M., Usability evaluation of domain-specific languages (2012) 2012 8th Int. Conf. on the Quality of Information and Comm. Technology, pp. 342-347. , https://doi.org/10.1109/QUATIC.2012.63; Fowler, M., (2010) Domain-specific Languages, , Pearson Education; (2000) Programmable Controllers-Part 7: Fuzzy Control Programming, , IEC 61131-7. Standard. International Electrotechnical Commission (IEC), Geneva, CH; Ivory, M.Y., Hearst, M.A., The state of the art in automating usability evaluation of user interfaces (2001) Comput. Surveys, 33 (4), pp. 470-516; Mosqueira-Rey, E., Alonso-Ríos, D., Moret-Bonillo, V., Fernández-Varela, I., Álvarez-Estévez, D., A systematic approach to api usability: Taxonomy-derived criteria and a case study (2018) Information and Software Technology, 97, pp. 46-63. , https://doi.org/10.1016/j.infsof.2017.12.010; Nielsen, J., (1995) 10 Usability Heuristics for User Interface Design, , https://www.nngroup.com/articles/ten-usability-heuristics/, (1995). Acc. : 2018-09-01; Poltronieri, I., Francisco Zorzo, A., Bernardino, M., De Borba Campos, M., USA-DSL: USAbility evaluation framework for domainspecific languages (2018) 33rd Annual ACM Sym. on App. Comp. ACM, pp. 2013-2021},
