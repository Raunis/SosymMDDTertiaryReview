@ARTICLE{Petzolt2022,
author={Petzolt, S. and Hölzle, K. and Kullik, O. and Gergeleit, W. and Radunski, A.},
title={ORGANISATIONAL DIGITAL TRANSFORMATION OF SMEs—DEVELOPMENT AND APPLICATION OF A DIGITAL TRANSFORMATION MATURITY MODEL FOR BUSINESS MODEL TRANSFORMATION},
journal={International Journal of Innovation Management},
year={2022},
