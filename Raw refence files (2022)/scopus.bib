@ARTICLE{Portocarrero2014,
author={Portocarrero, J.M.T. and Delicato, F.C. and Pires, P.F. and Gámez, N. and Fuentes, L. and Ludovino, D. and Ferreira, P.},
title={Autonomic Wireless Sensor Networks: A Systematic Literature Review},
journal={Journal of Sensors},
year={2014},
