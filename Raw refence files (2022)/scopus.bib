@CONFERENCE{Rishu2021,
author={Rishu},
title={Use of Pupillometry for Emotion Recognition and Ophthalmology Studies: A Systematic Review},
journal={2021 9th International Conference on Reliability, Infocom Technologies and Optimization (Trends and Future Directions), ICRITO 2021},
year={2021},
doi={10.1109/ICRITO51393.2021.9596098},
note={cited By 0; Conference of 9th IEEE International Conference on Reliability, Infocom Technologies and Optimization (Trends and Future Directions), ICRITO 2021 ; Conference Date: 3 September 2021 Through 4 September 2021;  Conference Code:174236},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85123343402&doi=10.1109%2fICRITO51393.2021.9596098&partnerID=40&md5=09c3c2dc3f6fac8902c4d7361b2e5ff4},
abstract={In recent years, the study of emotion has increased due to the interaction of humans with the machine. It is helpful to interpret human actions and to improve the relationship between humans and machines for developing software that can understand the human states and can take action accordingly. The most accurate approach to recognize emotions, pupil diameter (PD) has been discussed in this study. The reason for selecting this approach is that it is directly controlled by the Autonomic Nervous System (ANS) and is easy to detect. The main aim of this paper is to recognize the difference in pupil diameter due to the positive and negative emotional states of a person. Numerous researches have proposed different methods for detecting emotions by using pupillary response and achieved reliable accuracy. The study showed that the pupil diameter is influenced by different video, image, and script content indicating the state of the user. This study provides empirical evidence demonstrating how changes in the state of the user can be unobtrusively identified. © 2021 IEEE.},
references={Evaluation, N.F., Expressions, P.E., (1999) Neutral Face Evaluation, pp. 595-606; Zhu, J., Thagard, P., Emotion and action (2002) Philos. Psychol, 15 (1), pp. 19-36; Cole, L.C., Pi Ctu R Es VI Ewed, (3), pp. 3-4; Babiker, A., Faye, I., Malik, A., Pupillary behavior in positive and negative emotions (2013) IEEE ICSIPA 2013-IEEE Int. Conf. Signal Image Process. Appl, pp. 379-383; Gao, Y., Barreto, A., Adjouadi, M., Affective assessment of a computer user through the processing of the pupil diameter signal (2010) Innov. Comput. Sci. Softw. Eng, pp. 189-194; Partala, T., Surakka, V., Pupil size variation as an indication of affective processing (2003) Int. J. Hum. Comput. Stud, 59 (1-2), pp. 185-198; Babiker, A., Faye, I., Malik, A., Non-conscious behavior in emotion recognition: Gender effect (2013) Proc.-2013 IEEE 9th Int. Colloq. Signal Process. Its Appl. CSPA, pp. 258-262. , 2013; Lisetti, C.L., Nasoz, F., Using noninvasive wearable computers to recognize human emotions from physiological signals (2004) EURASIP J. Appl. Signal Processing, 2004 (11), pp. 1672-1687; Johnson, M.G., Muday, J.A., Schirillo, J.A., When viewing variations in paintings by mondrian, aesthetic preferences correlate with pupil size (2010) Psychol. Aesthetics, Creat. Arts, 4 (3), pp. 161-167; Valverde, L., De Lera, E., Fernàndez, C., (2010) Inferencing Emotions Through the Triangulation of Pupil Size Data, Facial Heuristics and Selfassessment Techniques; Szabadi, E., Bradshaw, C.M., (2015) The Inhibition of the Pupillary Light Reflex by the Threat of An Electric Shock : A Potential Laboratory Model of Human Anxiety, 10 (4), pp. 279-287; Woodmansee, J., (1967) The Pupil Reaction As An Index of Positive and Negative Affect; Janisse, M., Pupil size, affect and exposure frequency Soc. Behav. Pers; Ferrari, V., Novelty and emotion: Pupillary and cortical responses during viewing of natural scenes (2016) Biol. Psychol, 113, pp. 75-82; Henderson, R.R., Bradley, M.M., Lang, P.J., Modulation