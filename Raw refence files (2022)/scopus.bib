@CONFERENCE{Gottardi2015432,
author={Gottardi, T. and Braga, R.T.V.},
title={Model driven development success cases for domain-specific and general purpose approaches a systematic mapping},
journal={CIBSE 2015 - XVIII Ibero-American Conference on Software Engineering},
year={2015},
pages={432-445},
note={cited By 3; Conference of 18th Ibero-American Conference on Software Engineering, CIBSE 2015 ; Conference Date: 22 April 2015 Through 24 April 2015;  Conference Code:112515},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84936129815&partnerID=40&md5=430f8c146e62f04f77cceb8bbf85ab4c},
abstract={In the context of a Model Driven Software Engineering research effort, it was identified the need of surveying the success cases categorized by specific domains and by general purpose development processes. However, no systematic mapping related to this specific context was found. Therefore, we have conducted a systematic mapping with two objectives. The first objective was to identify specific domains in which MDSE is successful, while the second objective was to identify what are the challenges to apply this methodology to general purpose development processes. As results, we have identified that MDSE success cases are clustered into four domains: business information systems, network system design, web software applications and embedded systems. We could only identify five studies related to general purpose approaches and their challenges. The analysis of the results indicate that MDSE application is consolidated in specific domains. A common feature identified among studies related to general purpose processes is that their authors have reported a lack of methodologies that support MDSE in software projects since the inception phase. This secondary study was also the first to be conducted using a collaborative systematic mapping tool. Copyright © 2015 by the authors.},
references={Alkadi, I., Carver, D., A testing assistant for object-oriented programs (1998) Aerospace Conference, 4, pp. 149-158. , 1998 IEEE. vol. 4, (Mar); Asadi, M., Ramsin, R., (2008) Mda-based Methodologies: An Analytical Survey, pp. 419-431. , Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics) 5095 LNCS; Asadi, M., Ravakhah, M., Ramsin, R., An mda-based system development lifecycle (2008) Proceedings - 2nd Asia International Conference on Modelling and Simulation, AMS 2008, pp. 836-842. , Kuala Lumpur; Bislimovska, B., Bozzon, A., Brambilla, M., Fraternali, P., Textual and contentbased search in repositories of web application models (2014) ACM Trans. Web, 8 (2). , 11:1-11:47 (Mar); Brambilla, M., Cabot, J., Wimmer, M., (2012) Model-driven Software Engineering in Practice, , G - Reference, Information and Interdisciplinary Subjects Series, Morgan & Claypool; Cernickins, A., Nikiforova, O., Ozols, K., Sejans, J., An outline of conceptual framework for certification of mda tools (2010) Proceedings of the 2nd International Workshop on Model-Driven Architecture and Modelling Theory-Driven Development, pp. 60-69. , MDA and MTDD 2010, in Conjunction with ENASE 2010. Athens; Chitforoush, F., Yazdandoost, M., Ramsin, R., Methodology support for the model driven architecture (2007) Proceedings - Asia-Pacific Software Engineering Conference, pp. 454-461. , APSEC. Nagoya; Er, E., Tekinerdogan, B., Modsel: Model-driven software evolution language (2012) Formal and Practical Aspects of Domain-Specific Languages: Recent Developments, pp. 572-594. , Mernik, M. (ed); France, R., Rumpe, B., Model-driven development of complex software: A research roadmap 2007 Future of Software Engineering, pp. 37-54. , FOSE '07, IEEE Computer Society, Washington, DC, USA (2007); Hoffnagle, G.F., Beregi, W.E., Automating the software development process (1985) IBM Systems Journal, 24 (2), pp. 102-120; Hovsepyan, 