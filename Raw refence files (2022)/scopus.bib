@ARTICLE{Verbeek2012,
author={Verbeek, E.C. and Bakker, I.M.C. and Bevova, M.R. and Bochdanovits, Z. and Rizzu, P. and Sondervan, D. and Willemsen, G. and de Geus, E.J. and Smit, J.H. and Penninx, B.W. and Boomsma, D.I. and Hoogendijk, W.J.G. and Heutink, P.},
title={A fine-mapping study of 7 top scoring genes from a GWAS for major depressive disorder},
journal={PLoS ONE},
year={2012},
volume={7},
number={5},
doi={10.1371/journal.pone.0037384},
art_number={e37384},
note={cited By 27},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84861405831&doi=10.1371%2fjournal.pone.0037384&partnerID=40&md5=9b0f4ebeef27d62a3950741c3eabcda1},
abstract={Major depressive disorder (MDD) is a psychiatric disorder that is characterized -amongst others- by persistent depressed mood, loss of interest and pleasure and psychomotor retardation. Environmental circumstances have proven to influence the aetiology of the disease, but MDD also has an estimated 40% heritability, probably with a polygenic background. In 2009, a genome wide association study (GWAS) was performed on the Dutch GAIN-MDD cohort. A non-synonymous coding single nucleotide polymorphism (SNP) rs2522833 in the PCLO gene became only nominally significant after post-hoc analysis with an Australian cohort which used similar ascertainment. The absence of genome-wide significance may be caused by low SNP coverage of genes. To increase SNP coverage to 100% for common variants (m.a.f.&gt;0.1, r2&gt;0.8), we selected seven genes from the GAIN-MDD GWAS: PCLO, GZMK, ANPEP, AFAP1L1, ST3GAL6, FGF14 and PTK2B. We genotyped 349 SNPs and obtained the lowest P-value for rs2715147 in PCLO at P = 6.8E-7. We imputed, filling in missing genotypes, after which rs2715147 and rs2715148 showed the lowest P-value at P = 1.2E-6. When we created a haplotype of these SNPs together with the non-synonymous coding SNP rs2522833, the P-value decreased to P = 9.9E-7 but was not genome wide significant. Although our study did not identify a more strongly associated variant, the results for PCLO suggest that the causal variant is in high LD with rs2715147, rs2715148 and rs2522833. © 2012 Verbeek et al.},
references={Association, A.P., Diagnostic and Statistical Manual of Mental Disorders (1994), IV; Murray, C.J., Lopez, A.D., Evidence-based health policy-lessons from the Global Burden of Disease Study (1996) Science, 274, pp. 740-743; Kendler, K.S., Gatz, M., Gardner, C.O., Pedersen, N.L., A Swedish national twin study of lifetime major depression (2006) Am J Psychiatry, 163, pp. 109-114; Sullivan, P.F., Neale, M.C., Kendler, K.S., Genetic epidemiology of major depression: review and meta-analysis (2000) Am J Psychiatry, 157, pp. 1552-1562; Levinson, D.F., The genetics of depression: a review (2006) Biol Psychiatry, 60, pp. 84-92; Lopez-Leon, S., Janssens, A.C., Gonzalez-Zuloeta Ladd, A.M., Del-Favero, J., Meta-analyses of genetic studies on major depressive disorder (2008) Mol Psychiatry, 13, pp. 772-785; Cen, X.N.A., Ibi, D., Zhao, Y., Niwa, M., Taguchi, K., Identification of Piccolo as a regulator of behavioral plasticity and dopamine transporter internalization (2008) Mol Psychiaty, 13 (4), pp. 451-463; Leal-Ortiz, S., Waites, C.L., Terry-Lorenzo, R., Zamorano, P., Gundelfinger, E.D., Piccolo modulation of Synapsin1a dynamics regulates synaptic vesicle exocytosis (2008) J Cell Biol, 181, pp. 831-846; Boomsma, D.I., Willemsen, G., Sullivan, P.F., Heutink, P., Meijer, P., Genome-wide association of major depression: description of samples for the GAIN Major Depressive Disorder Study: NTR and NESDA biobank projects (2008) Eur J Hum Genet, 16, pp. 335-342; Sullivan, P.F., de Geus, E.J., Willemsen, G., James, M.R., Smit, J.H., Genome-wide association for major depressive disorder: a possible role for the presynaptic protein piccolo (2009) Mol Psychiatry, 14, pp. 359-375; Mailman, M.D., Feolo, M., Jin, Y., Kimura, M., Tryka, K., The NCBI dbGaP database of genotypes and phenotypes (2007) Nat Genet, 39, pp. 1181-1186; de Bakker, P.I., Yelensky, R., Pe'er, I., Gabriel, S.B., Daly, M.J., Efficiency and power in genetic association studies (2005) Nat Genet, 37, pp. 1217-12