@ARTICLE{Ahmad20221733,
author={Ahmad, S.I. and Rana, T. and Maqbool, A.},
title={A Model-Driven Framework for the Development of MVC-Based (Web) Application},
journal={Arabian Journal for Science and Engineering},
year={2022},
volume={47},
number={2},
pages={1733-1747},
doi={10.1007/s13369-021-06087-4},
note={cited By 1},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85113303466&doi=10.1007%2fs13369-021-06087-4&partnerID=40&md5=b3c0080fcec70a2b8c898ed7bb880d3c},
abstract={Model-driven engineering is a renowned software engineering methodology for design and development of software systems with the help of various types of models. Model–View–Controller (MVC) is a popular and extensively used architectural pattern for Web application development process in different platforms. Literature review reveals that there are implementation-level deficiencies in the form of complicated structure, time taken for development and maintenance of MVC-based Web application in different MVC-based frameworks. In this article, we introduce a unique model-driven framework approach to simplify the use of MVC-based frameworks for Web application development. In our approach, we introduce a unique mechanism with the help of a UML Profile model and a model to text transformation engine to automatically generate the implementation of any (Web) application in three defined MVC-based frameworks; our approach is extensible to support more MVC frameworks. For ease, we have created an application with GUI to generate the required MVC-based framework code. The application/implementation of our unique approach is verified with two benchmark case studies; results show that we closely generate the MVC-based Web application source code which is flexible to add critical application business logic. © 2021, King Fahd University of Petroleum & Minerals.},
references={Mittal, S., Martín, J.L.R., Model-driven systems engineering for netcentric system of systems with DEVS unified process (2013) Proceedings of the 2013 Winter Simulation Conference: Simulation: Making Decisions in a Complex World, pp. 1140-1151. , IEEE Press; Bézivin, J., In search of a basic principle for model driven engineering (2004) Novatica J. Spec. Issue, 5 (2), pp. 21-24; Kransner, G.E., A coolbook for using the model–view–controller user interface paradigm in Smalltalk-80 (1988) J. Object-Oriented Program., 1 (3), pp. 26-49; Richards, M., (2015) Software Architecture Patterns: Understanding Common Architecture Patterns and When to Use Them, , O’Reilly Media, Newton; Ping, Y., Kontogiannis, K., Lau, T.C., Transforming legacy web applications to the MVC architecture (2003) Eleventh Annual International Workshop on Software Technology and Engineering Practice, pp. 133-142; Aniche, M., Bavota, G., Treude, C., Gerosa, M.A., van Deursen, A., Code smells for model–view–controller architectures (2018) Empir. Softw. Eng., 23 (4), pp. 2121-2157; Ding, Y.H., Liu, C.H., Tang, Y.X., MVC pattern based on java (2012) Applied Mechanics and Materials, 198, pp. 537-541. , Trans Tech Publ; Plakalovic, D., Simic, D., (2010) Applying MVC and PAC Patterns in Mobile Applications.; Pordel, M., Yekeh, F., Jsf vs asp.Net, what are their limits (2008) IDT Workshop on Interesting Results in Computer Science and Engineering. Mälardalen University, Sweden; Srai, A., Guerouate, F., Berbiche, N., Lahsini, H.D., Applying MDA approach for spring MVC framework (2017) Int. J. Appl. Eng. Res., 12 (14), pp. 4372-4381; Irish, H., (2009) Creating a file hosting site with codeigniter, 2009; Javed, U., (2009), Address book; Beydeda, S., Book, M., Gruhn, V., (2005) Model-Driven Software Development, 15. , Springer, Berlin; (2002) Meta Object Facility (MOF) Specification 1.4; Fuentes-Fernández, L., Vallecillo-Moreno, A., An introduction to UML profiles (2004) UML Model Eng., 2, pp. 6-13; K