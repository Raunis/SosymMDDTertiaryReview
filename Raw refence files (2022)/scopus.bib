@CONFERENCE{Legowik2008434,
author={Legowik, D.M. and Mcfadden II, W.J.},
title={System of systems case study: The ballistic missile defense system},
journal={29th Annual National Conference of the American Society for Engineering Management 2008, ASEM 2008},
year={2008},
pages={434-442},
note={cited By 0; Conference of 29th Annual National Conference of the American Society for Engineering Management 2008, ASEM 2008 ; Conference Date: 12 November 2008 Through 15 November 2008;  Conference Code:97597},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84880067586&partnerID=40&md5=d2dd944ed1d07d5c604549c0ed2cd61b},
abstract={The mission of the Missile Defense Agency (MDA) is to develop and field an integrated, layered, Ballistic Missile Defense System (BMDS) to defend the United States, its deployed forces, allies, and friends against all ranges of enemy ballistic missiles in all phases of flight. BMDS constitutes a System of Systems (SoS) given its collection of element and component systems. This study provides a high-level assessment of the BMDS as an SoS, ensuring unique capabilities that can only be met with this mix of multiple, autonomous, and interacting systems, and presents a targeted list of courses of action to address key challenges. Research and analysis concluded that current and past analysis of BMDS has been primarily at the component level. Although component experimentation and testing are still important and required, tasks to investigate technical issues, in order to fully understand, develop and realize BMDS from an SoS perspective should be used. This work will aim at providing an integrated, interoperable, and networked system that will ensure common shared situational awareness, support coherent distributed and dispersed operations, and ensure decision superiority enabling more agile, dynamic, and robust mission scenarios. Based on detailed literature reviews, available documentation, and the MDA notional kill web methodology, the current and future BMDS are modeled and analyzed to reveal several areas of emphasis that should be addressed in order to properly assess BMDS's performance. Several recommendations and analytical methods are proposed to efficiently and effectively help test the elements and BMDS in order to better understand and design for the SoS performance envelope going forward. Copyright © (2008) by the American Society for Engineering Management.},
references={(2007) OTA Operational Assessment Requirements., , Ballistic Missile Defense System (BMDS) Operational Test Agency (OTA) Team. (, February 28); System of systems systems engineering guide: Considerations for systems engineering in a system of systems environment (2006) System of Systems Pilot Project, pp. 1-39. , Director, Systems and Software Engineering OUSD (ATL). (, December 22)., Version 9; Huynh, T., Osmundson, J., Systems of systems (sos) systems engineering methodology (2005) SoS Engineering Conference, , June 14- 15. A, Johnstown, PA; Huynh, T., Osmundson, J.A., Systems Engineering Methodology for Analyzing Systems of Systems; Keating, C., Mun, J.Hyon., Sousa-Poza, A., (2004) System of Systems Methodology, pp. 1-24. , Old Dominion University; (2007) PA 07 OTA Intended Use/Objectives & OTA V&V Acceptability Criteria, , Missile Defense Agency. (, March 27); Command, control, battle management, and communication (c2bmc) (2007) Global Engagement Manager (GEM, pp. 1-23. , Missile Defense Agency. (, May; (2005) Ballistic Missile Defense System Capability Assessment Plan (CAP), pp. 1-44. , Missile Defense Agency. (, September)., Version 1.0; (2005) Ballistic Missile Defense System (BMDS), , Missile Defense Agency, (, April 28). BMDS Historical Beginning; (2007) Performance Assessment 2007 (PA 07) Planning Order (U), pp. 1-1601. , Missile Defense Agency, Deputy for Engineering. (, June 27). Responsible Engineering Organization Engineering Directive, REO Engineering Directive 1; Systems of Systems Engineering Center of Excellence, , www.sosece.org, May 31, 2007; Modeling and simulation (2007) Performance Assessment 2007 Event Readiness Review (ERR), , Missile Defense Agency, (, August 16; (2007) Modeling and Simulation, pp. 1-149. , Missile Defense Agency, (, May 07). PA 07 Critical Design Review; (2007) OTA BMDS Ensemble Data Elements, , Missile Defense Agency, Operational Test Agency. (, May 22; (2007) Pa 07 collaborative analysis and assessment forum 