@ARTICLE{Perez2008127,
author={Perez, J.M. and Ruiz, F. and Piattini, M.},
title={MDE for BPM: A systematic review},
journal={Communications in Computer and Information Science},
year={2008},
volume={10},
pages={127-135},
doi={10.1007/978-3-540-70621-2_11},
note={cited By 6; Conference of 1st International Conference on Software and Data Technologies, ICSOFT 2006 ; Conference Date: 11 September 2006 Through 14 September 2006;  Conference Code:194669},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85013132700&doi=10.1007%2f978-3-540-70621-2_11&partnerID=40&md5=c2b84780b4e4bcd973983259a43f727b},
abstract={Due to the rapid change in the business processes of organizations, Business Process Management (BPM) has come into being. BPM helps business analysts to manage all concerns related to business processes, but the gap between these analysts and people who build the applications is still large. The organization’s value chain changes very rapidly; to modify simultaneously the systems that support the business management process is impossible. MDE (Model Driven Engineering) is a good support for transferring these business process changes to the systems that implement these processes. Thus, by using any MDE approach, such as MDA, the alignment between business people and software engineering should be improved. To discover the different proposals that exist in this area, a systematic review was performed. As a result, the OMG’s Business Process Definition Metamodel (BPDM) has been identified as the standard that will be the key for the application of MDA for BPM. © Springer-Verlag Berlin Heidelberg 2008.},
references={Smith, H., The emergence of Business Process Management (2002) CSC’s Research Services; Frankel, D.S., BPM and MDA (2003) The Rise of Model-Driven Enterprise Systems, , Business Process Trends; Miller, J., Mukerji, J., MDA Guide Version 1.0.1 (2003) OMG; Bézivin, J., MDA: From hype to hope, and reality (2003) UML 2003. 6Th International Conference., , ATLAS Group; Kitchenham, B., Procedures for performing systematic reviews (2004) NICTA Joint Technical Report; Travassos, G.H., Biolchini, J., Gomes, P., Cruz, A.C., (2005) Systematic Review in Software Engineering, , Technical Report; Smith, H., BPM and MDA: Competitors, alternatives or complementary (2003) Business Process Trends; Zeng, L., Lei, H., Dikun, M., Chang, H., Bhaskaran, K., Mode-driven business performance management (2005) ICEBE 2005. Proceedings of the 2005 IEEE International Conference on E-Business Engineering, , IEEE, Los Alamitos; Pfadenhauer, K., Dustdar, S., Kittl, B., Comparision of two distinctive model driven web service orchestration proposals (2005) CECW 2005. Proceedings of the 2005 Seventh IEEE International Conference on E-Commerce Technology Workshops, , IEEE, Los Alamitos; Kano, M., Koide, A., Liu, T., Ramachandran, B., Analysis and simulation of business solutions in a service oriented architecture (2005) IBM Systems Journals, 44 (4); Roser, S., Bauer, B., A categorization of collaborative business process modeling techniques (2005) CECW 2005. Proceedings of the 2005 Seventh IEEE International Conference on E-Commerce Technology Workshops, , IEEE, Los Alamitos; Business process modeling and standarization (2004) Bpmg.Org; Rosen, M., SOA, BPM and MDA (2004) CTO Azora Technologies; Frankel, D.S., BPMI and OMG: The BPM Merger (2005) Business Process Trends; Harmon, P., The OMG’s model driven architecture and BPM (2004) Business Process Trends; Business Process Definition Metamodel, Request for Proposal (2003) OMG Document, , http://www.omg.org/docs/bei/03-01-06.pdf, June 1; Bor