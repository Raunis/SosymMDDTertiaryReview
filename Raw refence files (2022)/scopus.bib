@CONFERENCE{Giraldo2014,
author={Giraldo, F.D. and España, S. and Pastor, O.},
title={Analysing the concept of quality in model-driven engineering literature: A systematic review},
journal={Proceedings - International Conference on Research Challenges in Information Science},
year={2014},
doi={10.1109/RCIS.2014.6861030},
art_number={6861030},
note={cited By 13; Conference of 8th IEEE International Conference on Research Challenges in Information Science, IEEE RCIS 2014 ; Conference Date: 28 May 2014 Through 30 May 2014;  Conference Code:107211},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84906766697&doi=10.1109%2fRCIS.2014.6861030&partnerID=40&md5=2d8f996eecd2d2cb68c2e83d40713a16},
abstract={The Model-Driven Engineering (MDE) research must manage a diversity of conceptions despite the global truth about the use of conceptual models as one way for representing and managing the development of complex information systems. Due to this diversity of conceptions and the multiple MDE compliance interpretations, a pletora of definitions about quality in models are emerging, each one tackling specific dimensions involved in MDE projects. In order to explore a consensus about quality in models and model-driven contexts an identification of the previous proposals for quality in models is needed. The main contribution of this work is the identification of representative trends about quality definition in MDE, and therefore, exposing the implications of the multiple quality interpretations as consequence of the diversity in MDE compliance works. © 2014 IEEE.},
