@ARTICLE{Magalhães2021412,
author={Magalhães, A.P. and Maciel, R.S.P. and Andrade, A.M.S.},
title={An Investigation of Currently Used Aspects in Model Transformation Development},
journal={Lecture Notes in Business Information Processing},
year={2021},
volume={417},
pages={412-436},
doi={10.1007/978-3-030-75418-1_19},
note={cited By 0; Conference of 22nd International Conference on Enterprise Information Systems, ICEIS 2020 ; Conference Date: 5 May 2020 Through 7 May 2020;  Conference Code:258429},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85106445235&doi=10.1007%2f978-3-030-75418-1_19&partnerID=40&md5=d76e240df5c93594f0774c3282dadfb8},
abstract={In Model driven development, a transformation chain is responsible for the conversion of high abstraction level models into other models until code generation. It comprises a set of transformation programs that automates a software development process. The development of a transformation chain is not a trivial task as it involves metamodeling, specific languages, knowledge of specific tools, and other issues that are not common in traditional software project development. Therefore, the adoption of software engineering facilities such as development processes, modeling languages, patterns, among others, have been proposed to assist in transformation development. This paper discusses currently facilities used to develop model transformations from a systematic literature review result. To better organize the currently aspects found, we structure the proposals according to a classification concerning software engineering development technologies in order to help developers and researchers in searching by solutions and challenges. © 2021, Springer Nature Switzerland AG.},
