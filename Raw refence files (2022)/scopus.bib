@CONFERENCE{Jiang2020296,
author={Jiang, X.},
title={Incorporating service design for industry 4.0: A scientometric review for green and digital transformation driven by service design},
journal={Proceedings - 2020 Management Science Informatization and Economic Innovation Development Conference, MSIEID 2020},
year={2020},
pages={296-299},
doi={10.1109/MSIEID52046.2020.00061},
art_number={9382585},
note={cited By 2; Conference of 2020 International Conference on Management Science Informatization and Economic Innovation Development, MSIEID 2020 ; Conference Date: 18 December 2020 Through 20 December 2020;  Conference Code:168052},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85103741413&doi=10.1109%2fMSIEID52046.2020.00061&partnerID=40&md5=642a3452525b2e7c01300db2769d74e8},
abstract={Borne the potentials on optimizing organizational resources and service delivery process to improving the overall customer experience, service design has become an important means of digital transformation by promoting consumption upgrading and business model transformation. Along with digital technology, the main driver of industry 4.0, service design can be able to affect every aspect of the product life cycle, so that the production, delivery, consumption, and investment can be more sustainable. Therefore, how can we advance service design for system change bears great potential for addressing complex issues towards green and digital transformation. However, a comprehensive review of the intersections of related works of literature is missing. The purpose of this study is to provide a systematic review of the core literature and identify future research directions and challenges so that organizations can better utilize service design for green and digital transformation. Based on 549 articles retrieved from the Web of Science database, this research examined the main journals, emerging disciplines, and top author keywords, summarizing the major work surrounding the relationship between digital transformation and service design. The research found that researches on the intersection of service design and digital transformation have been undertaken mainly in three disciplines: industrial engineering, business and management science, environmental studies and green technology. Also, service design and Product-Service System can help organizations navigate the required transformation processes. The paper also suggests the need to further explore the intersection of service design and related research fronts of data-driven, SMEs, and future studies, with specific questions raised. © 2020 IEEE.},
references={Borst, M., Digital transformation: An ieee digital reality initiative white paper (2020) IEEE Digital Reality Initiative, , https://digitalreality.ieee.org/images/files/pdf/digital-transformationwhite-paper.pdf; (2020) Service Design Report 2020, , Dargon Design Foundatin and XXY Innovation Oct; Rae, J., Fishman, T., Chew, B., Doyle, A.T., Nelson, C., (2020) Implementing Service Design in Government, , https://www2.deloitte.com/us/en/insights/industry/publicsector/implementing-service-design-in-government.html, accessed Nov. 29; (2020) The Scottish Approach to Service Design (SAtSD), , Scottish Government Digital Directorate SGD00099, Apr. 2019. Accessed: Dec. 12; Barquet, A.P., Seidel, J., Seliger, G., Kohl, H., Sustainability factors for pss business models (2016) Procedia CIRP, 47, pp. 436-441. , Jan; Jarneving, B., Bibliographic coupling and its application to research-front and other core documents (2007) Journal of Informetrics, 1 (4), pp. 287-307. , Jan; Featherman, M.S., Valacich, J.S., Wells, J.D., Is that authentic or artificial? Understanding consumer perceptions of risk in e-service encounters (2006) Information Systems Journal, 16 (2), pp. 107-134. , Apr; Hsiao, Y.-H., Chen, M.-C., Liao, W.-C., Logistics service design for cross-border E-commerce using Kansei engineering with text-miningbased online content analysis (2017) Telematics and Informatics, 34 (4), pp. 284-302. , Jul; Lerch, C., Gotsch, M., Digitalized product-service systems in manufacturing firms: A case study analysis (2015) Research-Technology Management, 58 (5), pp. 45-52. , Sep; Herterich, M.M., Uebernickel, F., Brenner, W., The impact of cyberphysical systems on industrial services in manufacturing (2015) Procedia CIRP, 30, pp. 323-328; Bressanelli, G., Adrodegari, F., Perona, M., Saccani, N., Exploring how usage-focused business models enable circular economy through digital technologies (2018) Sustainability, 10 (3), p. 639. , Feb; Frank, A.G., Mendes, G.H.S., Ayala, N.F.,