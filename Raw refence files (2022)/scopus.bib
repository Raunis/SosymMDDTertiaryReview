@CONFERENCE{Horkoff2016106,
author={Horkoff, J. and Aydemir, F.B. and Cardoso, E. and Li, T. and Maté, A. and Paja, E. and Salnitri, M. and Mylopoulos, J. and Giorgini, P.},
title={Goal-Oriented Requirements Engineering: A Systematic Literature Map},
journal={Proceedings - 2016 IEEE 24th International Requirements Engineering Conference, RE 2016},
year={2016},
pages={106-115},
