@CONFERENCE{Nguyen2015246,
author={Nguyen, P.H. and Yskout, K. and Heyman, T. and Klein, J. and Scandariato, R. and Le Traon, Y.},
title={SoSPa: A system of Security design Patterns for systematically engineering secure systems},
journal={2015 ACM/IEEE 18th International Conference on Model Driven Engineering Languages and Systems, MODELS 2015 - Proceedings},
year={2015},
pages={246-255},
doi={10.1109/MODELS.2015.7338255},
art_number={7338255},
note={cited By 15; Conference of 18th ACM/IEEE International Conference on Model Driven Engineering Languages and Systems, MODELS 2015 ; Conference Date: 30 September 2015 Through 2 October 2015;  Conference Code:118445},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84961642292&doi=10.1109%2fMODELS.2015.7338255&partnerID=40&md5=411101d607b22ae71b5b16467903a6b5},
abstract={Model-Driven Security (MDS) for secure systems development still has limitations to be more applicable in practice. A recent systematic review of MDS shows that current MDS approaches have not dealt with multiple security concerns systematically. Besides, catalogs of security patterns which can address multiple security concerns have not been applied efficiently. This paper presents an MDS approach based on a unified System of Security design Patterns (SoSPa). In SoSPa, security design patterns are collected, specified as reusable aspect models to form a coherent system of them that guides developers in systematically addressing multiple security concerns. SoSPa consists of not only interrelated security design patterns but also a refinement process towards their application. We applied SoSPa to design the security of crisis management systems. The result shows that multiple security concerns in the case study have been addressed by systematically integrating different security solutions. © 2015 IEEE.},
references={Alam, O., Kienzle, J., Mussbacher, G., (2013) Concern-Oriented Software Design, , Model-Driven Engineering Languages and Systems; Fernandez-Buglioni, E., (2013) Security Patterns in Practice: Designing Secure Architectures Using Software Patterns, , John Wiley & Sons; Georg, G., (2009) An Aspect-Oriented Methodology for Designing Secure Applications, , Information and Software Technology; Heyman, T., (2007) An Analysis of the Security Patterns Landscape, , Software Engineering for Secure Systems (SESS; Horcas, J.-M., Pinto, M., Fuentes, L., (2014) An Aspect-oriented Model Transformation to Weave Security Using CVL, pp. 138-150. , MODELSWARD IEEE; Kienzle, J., (2010) Aspect-Oriented Design with Reusable Aspect Models, pp. 272-320. , TAOSD VII. Springer; Kienzle, J., Guelfi, N., Mustafiz, S., (2010) Crisis Management Systems: A Case Study for Aspect-Oriented Modeling, pp. 1-22. , Transactions on aspect-oriented software development (TAOSD) VII; Kobashi, T., Validating security design patterns application using model testing (2013) Availability, Reliability and Security (ARES), 2013 Eighth International Conference on, pp. 62-71. , IEEE; Mouheb, D., Aspect-oriented modeling for representing and integrating security concerns in UML (2010) Software Engineering Research, Management and Applications 2010, pp. 197-213. , Springer Berlin Heidelberg; Nguyen, P.H., Klein, J., Le Traon, Y., Model-driven security with a system of aspect-oriented security design patterns (2014) VAO@STAF. VAO '14, pp. 5151-5154. , ACM; Nguyen, P.H., A systematic review of model driven security (2013) The 20th Asia-Pacific Software Engineering Conference; Schumacher, M., (2013) Security Patterns: Integrating Security and Systems Engineering, , John Wiley & Sons; Shiroma, Y., (2010) Model-Driven Security Patterns Application Based on Dependences among Patterns, pp. 555-559. , Availability, Reliability, and Security (ARES; Steel, C., Nagappan, R., (2006) Core Security Patterns: Best Practi