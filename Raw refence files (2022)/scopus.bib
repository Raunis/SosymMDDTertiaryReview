@ARTICLE{Delgado201188,
author={Delgado, A. and Ruiz, F. and de Guzmán, I.G.-R. and Piattini, M.},
title={Main principles on the integration of SOC and MDD paradigms to Business Processes: A systematic review},
journal={Communications in Computer and Information Science},
year={2011},
volume={170},
pages={88-108},
doi={10.1007/978-3-642-29578-2},
note={cited By 3; Conference of 5th International Conference on Software and Data Technologies, ICSOFT 2010 ; Conference Date: 22 July 2010 Through 24 July 2010;  Conference Code:98838},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84879468323&doi=10.1007%2f978-3-642-29578-2&partnerID=40&md5=1a97b96bf8fffaf8df8cec64e85f7315},
abstract={Over the last few years organizations have been dealing with the integration of their business processes and software and technologies to support their realization. One challenge is to unite the vision from business and software areas, to design and implement business processes in a way that allows organizations to react agilely to changes. New paradigms have appeared to support this vision: Business Process Management (BPM), Service-Oriented Computing (SOC) and Model-Driven Development (MDD). BPM deals with managing business process lifecycle from modeling, implementation, execution and evaluation to find improvement opportunities. SOC bases the design and implementation of software on services, which are defined to support business processes. MDD focus is on models, allowing the definition of automatic transformation between them along with code generation for different platforms. In this article we present the main principles for the integration of these paradigms as found in a systematic review carried out with the objective of establishing the bases for our research. © Springer-Verlag Berlin Heidelberg 2011.},
