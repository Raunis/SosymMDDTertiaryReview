@ARTICLE{Allian20201282,
author={Allian, A.P. and Oliveira, E., Jr. and Capilla, R. and Nakagawa, E.Y.},
title={Have variability tools fulfilled the needs of the software industry?},
journal={Journal of Universal Computer Science},
year={2020},
volume={26},
number={10},
pages={1282-1311},
note={cited By 2},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85100454054&partnerID=40&md5=07610f35c3c2170dd0e86167bc7815c3},
abstract={For nearly 30 years, industry and researchers have proposed many software variability tools to cope with the complexity of modeling variability in software development, followed by a number of publications on variability techniques built upon theoretical foundations. After more than 25 years of the practice of software variabil-ity, there are not many studies investigating the impact of software variability tools in the industry and the perception of practitioners. For this reason, we investigate in this research work how existing software variability tools fulfill the needs of companies demanding this kind of tool support. We conducted a survey with practitioners from companies in eight different countries in order to analyze the missing capabilities of software variability management tools and we compared the results of the survey with the scientific literature through a systematic mapping study (SMS) to analyze if the proposed solutions cover the needs required by practitioners. Our major findings in-dicate that many tools lack important qualities such as interoperability, collaborative work, code generation, scalability, impact analysis, and test; while the results from the SMS showed these such capabilities are, to some extent, found in some of the existing tools. © 2020, IICM. All rights reserved.},
references={Bashroush, R., Garba, M., Rabiser, R., Groher, I., Bot-terweck, G., CASE tool support for variability management in software product lines (2017) ACM Comput. Surv, 50 (1). , [Bashroush et al., 2017a] (a). 14:1–14:45; Bashroush, R., Garba, M., Rabiser, R., Groher, I., Bot-terweck, G., CASE tool support for variability management in software product lines (2017) ACM Comput. Surv, 50 (1). , [Bashroush et al., 2017b] (b). 14:1–14:45; Benavides, D., Segura, S., Cortés, A. R., Automated analysis of feature models 20 years later: A literature review (2010) Information Systems, 35 (6), pp. 615-636. , [Benavides et al., 2010]; Berger, T., Nair, D., Rublack, R., Atlee, J. M., Czarnecki, K., Wasowski, A., Three cases of feature-based variability modeling in in-dustry (2014) 17th International Conference on Model-Driven Engineering Languages and Systems (MODELS), MODELS ’14, pp. 302-319. , [Berger et al., 2014] pages Valencia, Spain. Springer International Publishing; Berger, T., Rublack, R., Nair, D., Atlee, J. M., Becker, M., Czar-necki, K., Wsowski, A., A survey of variability modeling in industrial prac-tice (2013) 7th International Workshop on Variability Modelling of Software-intensive Systems (VaMoS), VAMOS ’13, pp. 1-7. , [Berger et al., 2013] pages 7: 8, Pisa, Italy. ACM; Bhumula, M. R., Comparative study and analysis of variability tools (2013) Computing Resource Repository, pp. 1-35. , [Bhumula, 2013] abs/1304.3912; Bosch, J., Capilla, R., Hilliard, R., Trends in systems and software variability (2015) IEEE Software, 32 (3), pp. 44-51. , [Bosch et al., 2015]; Capilla, R., Bosch, J., Kang, K. C., (2013) Systems and Software Variability Management-Concepts, Tools and Experiences, , [Capilla et al., 2013] editors Springer; Chituc, C., Interoperability standards for seamless communi-cation: An analysis of domain-specific initiatives (2017) OTM, OTM ’17, pp. 36-46. , [Chituc, 2017] pages Springer International Publishing; Cross, J. H., Hendrix, T. D., Barowski