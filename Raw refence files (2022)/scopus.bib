title={Big data etl implementation approaches: A systematic literature review},
journal={Proceedings of the International Conference on Software Engineering and Knowledge Engineering, SEKE},
year={2018},
volume={2018-July},
pages={714-715},
doi={10.18293/SEKE2018-152},
note={cited By 5; Conference of 30th International Conference on Software Engineering and Knowledge Engineering, SEKE 2018 ; Conference Date: 1 July 2018 Through 3 July 2018;  Conference Code:141853},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85056896373&doi=10.18293%2fSEKE2018-152&partnerID=40&md5=ab436776639f4ec4aed85e2ba8b0aaae},
abstract={Extract, transform, load (ETL) is an essential technique for integrating data from multiple sources into a data warehouse. ETL is applicable to data warehousing, big data, and business intelligence. Through a systematic literature review of 97 papers, this research identifies and evaluates the current approaches used to implement existing ETL solutions. We found that conceptual modeling such as UML, BPMN, and MDA is the most popular approach used to implement ETL solutions. However, innovative approaches such as machine learning, artificial intelligence, and robotics are either under-utilized or not used at all to develop ETL solutions. Additionally, we discuss the implications of these to ETL research and practice. © 2018 Universitat zu Koln. All rights reserved.},
references={Gudivada, V.N., Baeza-Yates, R.A., Raghavan, V.V., Big data: Promises and problems (2015) IEEE Computer, 48 (3), pp. 20-23; Kitchenham, B., Charters, S., Guidelines for performing systematic literature reviews in software Engineering Version 2.3 (2007) Engineering, 45, p. 1051; Nwokeji, J.C., Aqlan, F., Barn, B., Clark, T., Kulkarni, V., A modelling technique for enterprise agility (2018) Proceedings of the 51st Hawaii International Conference on System Sciences; El Akkaoui, Z., Zimanyi, E., Mazon, J.N., Lopez, J.C., Mondejar, T., A bpmn-based design and maintenance framework for etl processes (2013) International Journal of Data Warehousing and Mining},
sponsors={Knowledge Systems Institute Graduate School; KSI Research Inc.},
document_type={Conference Paper},
source={Scopus},
}

