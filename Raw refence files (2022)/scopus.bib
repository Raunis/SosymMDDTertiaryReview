@CONFERENCE{Derave202115,
author={Derave, T. and Sales, T.P. and Gailly, F. and Poels, G.},
title={Understanding digital marketplace business models: An ontology approach},
journal={CEUR Workshop Proceedings},
year={2021},
volume={3031},
pages={15-26},
note={cited By 0; Conference of 14th Workshops on Practice of Enterprise Modelling Workshops, PoEM-WS 2021 ; Conference Date: 24 November 2021;  Conference Code:175196},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85121298879&partnerID=40&md5=d6f23428277cce244c9ed9b4e6585904},
abstract={Digital marketplaces, including sharing economy platforms, are digital platforms that may operate under a large variety of business models. Business model variations are typically conceptualized in taxonomies, but these fall short in describing platform user roles and role-specific digital platform functionality. Reference ontologies offer more potential for capturing this information and thus provide a conceptual basis for model-driven development of platform software. This paper presents an extension of the Digital Platform Ontology (DPO) of Derave, Sales, Gailly and Poels (2020) that is agnostic to business model choices. We extend the DPO with digital platform business model ontology modules, based on an analysis of digital marketplace business models, that was informed by a literature review and a sample of existing digital marketplaces. The new ontology modules can be used as building blocks to model a digital marketplace operating under a chosen business model. © 2021 CEUR-WS. All rights reserved.},
references={Ranjbari, M., Morales-Alonso, G., Carrasco-Gallego, R., Grijalvo, M., Business Model Innovation in Sharing Economy: A Benchmark Approach (2017) 2nd Int. Conf. New Bus. Model. - Explor. a Chang. view Organ. value Creat. Dev. New Bus. Model, 2511, pp. 201-212; Frenken, K., Schor, J., Putting the sharing economy into perspective (2017) Environ. Innov. Soc. Transitions, 23, pp. 3-10; Zervas, G., Proserpio, D., Byers, J.W., The Rise of the Sharing Economy: Estimating the Impact of Airbnb on the Hotel Industry (2014) J. Mark. Res, p. 2731799; Derave, T., Prince, T., Gailly, F., Comparing Digital Platform Types in the Platform Economy (2021) Caise 2021, pp. 5-10; Sutherland, W., Jarrahi, M.H., The sharing economy and digital platforms: A review and research agenda (2018) Int. J. Inf. Manage, 43, pp. 328-341; Hermes, S., Maier, M., Hein, A., Böhm, M., Krcmar, H., User Roles on Peer-to-Peer Sharing Platforms: A Critical Review of the Literature and Recommended Remedies (2020) Proc. 53rd Hawaii Int. Conf. Syst. Sci, pp. 804-813; Täuscher, K., Laudien, S.M., Understanding platform business models: A mixed methods study of marketplaces (2018) Eur. Manag. J, 36; Amit, R., Zott, C., (2001) Value Creation in E-Business, 520, pp. 493-520; Derave, T., Sales, T.P., Gailly, F., Poels, G., Towards a Reference Ontology for Digital Platforms (2020) ER 2020, pp. 1-14; Falbo, R., SABiO: Systematic approach for building ontologies (2014) CEUR Workshop Proc, 1301. , de A; Pergl, R., Sales, T.P., Rybola, Z., Towards ontoUML for software engineering: From domain ontology to implementation model (2013) Lect. Notes Comput. Sci. (including Subser. Lect. Notes Artif. Intell. Lect. Notes Bioinformatics), pp. 249-263. , 8216 LNCS; Guizzardi, G., (2005) Ontological Foundations for Structural Conceptual Models; Guizzardi, G., Fonseca, C.M., Benevides, A.B., Almeida, J.P.A., Porello, D., Sales, T.P., Endurant types in ontology-driven conceptual modeling: Towards ontoUML 2.0 (2018) Lect. Not