@CONFERENCE{Sabir201743,
author={Sabir, U. and Azam, F. and Anwar, M.W.},
title={A comprehensive investigation of Model Driven Architecture (MDA) for reverse engineering},
journal={ACM International Conference Proceeding Series},
year={2017},
pages={43-48},
doi={10.1145/3178212.3178215},
note={cited By 2; Conference of 2017 International Conference on Software and e-Business, ICSEB 2017 ; Conference Date: 28 December 2017 Through 30 December 2017;  Conference Code:135441},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85045936852&doi=10.1145%2f3178212.3178215&partnerID=40&md5=9cddc93f06e67a617223a0a8f2c21d6d},
abstract={Models and transformations are the primary elements of Model Driven Architecture (MDA). On the other hand, Reverse Engineering (RE) also deals with the intermediate models and different transformation practices to produce the desired output models. Consequently, MDA have been utilized in the field of reverse engineering. This article inspects and summarizes the applications of MDA for RE. Particularly, a Systematic Literature Review (SLR) is performed to analyze 23 studies published during 2006-2017. Consequently, five leading RE techniques are identified. Moreover, 10 tools regarding MDA-based reversed engineering have been presented. Furthermore, modeling and transformation approaches are investigated for reverse engineering. The results of this SLR are highly valuable for academia and industry professionals of the domain. © 2017 Association for Computing Machinery.},
references={Garzón, M.A., Lethbridge, T.C., Aljamaan, H., Badreddin, O., Reverse engineering of object-oriented code into umple using an incremental and rule-based approach (2014) Proceedings of 24th Annual ICCSSE; Timothy, C., Forward, A., Badreddin, O., (2010) Umplification: Refactoring to Incrementally Add Abstraction to A Program in 17th WCRE; Favre, L., Martinez, L., Pereira, C., MDA-Based reverseengineering of object oriented code (2009) EB& ISM, pp. 251-263. , Springer Berlin Heidelberg; Cánovas, J.L., García, J., Extracting models from source code in software modernization (2014) SASM, 13, pp. 713-734; Echeverria, R.R., Pavon, V.M., Generating a conceptual representation of a legacy web applications (2013) ICWISE, pp. 231-240. , Springer Berlin Heidelberg; Trias, F., Castro marcos and marcos reverse engineering applied to cms-based web applications coded in php: A proposal of migration (2013) ENASE, pp. 241-256; Martínez C Cachero, Y., Meliá, S., Empirical study on the maintainability of Web applications: Model-driven Engineering vs Code-centric (2014) Empirical Software Engineering, 19 (6), pp. 1887-1920; Garzón, M.A., (2015) Umple: A Framework for Model Driven Development of Object-Oriented Systems, , (SANER); Couto, R., Ribeiro and Campos, A Patterns Based RE Approach for Java source code (2012) Ieee 35th SE Workshop; Brunelière, H., MoDisco: A model driven reverse engineering framework (2014) IST, pp. 1012-1032; Favre, L., Martinez, L., Pereira, C., Formalizing mdabased reverse engineering processes (2008) 6th ICSERA; Su, J.G., McComb, T., MDA-Based reengineering with object-z ICMDEL&S, pp. 291-305; P-Castillo, R., G-Rodríguez, I., Piattini, M., Knowledge Discovery Metamodel- ISO/IEC 19506; Trias, F., RE-CMS: A reverse engineering toolkit for the migration to cms-based web applications (2015) SAC'15, , April 13-17 Salamanca, Spain; Brunelière, H., MoDisco: A generic and extensible framework for model driven reverse engineering Proceedings of the IEEE/ACM