@CONFERENCE{Schwägerl2016203,
author={Schwägerl, F. and Buchmann, T. and Westfechtel, B.},
title={Multi-variant Model Transformations - A problem statement},
journal={ENASE 2016 - Proceedings of the 11th International Conference on Evaluation of Novel Software Approaches to Software Engineering},
year={2016},
pages={203-209},
doi={10.5220/0005878702030209},
note={cited By 5; Conference of 11th International Conference on Evaluation of Novel Software Approaches to Software Engineering, ENASE 2016 ; Conference Date: 27 April 2016 Through 28 April 2016;  Conference Code:122377},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-84979640379&doi=10.5220%2f0005878702030209&partnerID=40&md5=98af85852889b831b32984dea8256ddd},
abstract={Model Transformations are a key element of Model-Driven Software Engineering. As soon as variability is involved, transformations become increasingly complicated. The lack of support for variability in model transformations impairs the acceptance of approaches to organized reuse such as software product lines. In this position paper, the general problem of multi-variant model transformations is formulated for MOF-based, XMI-serialized models. A simplistic case study is presented to specify the input and the expected output of such a transformation. Furthermore, requirements for tool support are defined, including a standardized representation of both multi-variant model instances and variability information, as well as an execution specification for multi-variant transformations. A literature review reveals that the problem is weakly identified and often solved using ad-hoc solutions; there exists no tool providing a general solution to the proposed problem statement. The observations presented here may serve for the future development of standards and tools. Copyright © 2016 by SCITEPRESS - Science and Technology Publications, Lda. All rights reserved.},
references={Altmanninger, K., Seidl, M., Wimmer, M., A survey on model versioning approaches (2009) International Journal of Web Information Systems (IJWIS), 5 (3), pp. 271-304; Buchmann, T., Schwägerl, F., Developing heterogeneous software product lines with FAMILE - A model-driven approach (2015) International Journal on Advances in Software, 8 (1-2), pp. 232-246; Buchmann, T., Schwägerl, F., On A-posteriori integration of ecore models and hand-written Java code (2015) Proceedings of the 10th International Conference on Software Paradigm Trends, pp. 95-102. , Pascal Lorenz, M. v. S. and Cardoso, J., editors, SCITEPRESS; Czarnecki, K., Kim, C.H.P., Cardinality-based feature modeling and constraints: A progress report (2005) International Workshop on Software Factories at OOPSLA'05, , San Diego, California, USA. ACM; Gomaa, H., (2004) Designing Software Product Lines with UML: From use Cases to Pattern-Based Software Architectures, , Addison-Wesley, Boston, MA; Haugen, O., Møller-Pedersen, B., Oldevik, J., Olsen, G.K., Svendsen, A., Adding standardized variability to domain specific languages (2008) Proceedings of the 2008 12th International Software Product Line Conference, SPLC'08, pp. 139-148. , Washington, DC, USA. IEEE Computer Society; Heidenreich, F., Kopcsek, J., Wende, C., FeatureMapper: Mapping features to models (2008) Companion Proceedings of the 30th International Conference on Software Engineering (ICSE'08), pp. 943-944. , Leipzig, Germany; Jouault, F., Kurtev, I., Transforming models with atl (2006) Proceedings of the 2005 International Conference on Satellite Events at the MoDELS, MoDELS'05, pp. 128-138. , Berlin, Heidelberg. Springer-Verlag; Kang, K.C., Cohen, S.G., Hess, J.A., Novak, W.E., Peterson, A.S., (1990) Feature-oriented Domain Analysis (FODA) Feasibility Study, , Technical Report, Carnegie-Mellon University, Software Engineering Institute; Lopez-Herrejon, R.E., Batory, D.S., A standard problem for evaluating product-line methodologies (200