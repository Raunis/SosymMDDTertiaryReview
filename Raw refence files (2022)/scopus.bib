@ARTICLE{Poltronieri2021299,
author={Poltronieri, I. and Pedroso, A.C. and Zorzo, A.F. and Bernardino, M. and de Borba Campos, M.},
title={Is Usability Evaluation of DSL Still a Trending Topic?},
journal={Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
year={2021},
volume={12762 LNCS},
pages={299-317},
doi={10.1007/978-3-030-78462-1_23},
note={cited By 4; Conference of Human Computer Interaction thematic area of the 23rd International Conference on Human-Computer Interaction, HCII 2021 ; Conference Date: 24 July 2021 Through 29 July 2021;  Conference Code:262079},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85112178721&doi=10.1007%2f978-3-030-78462-1_23&partnerID=40&md5=40370bc06b9165963a4d1d64e2faf679},
abstract={In the past, several works have considered usability, user experience, and design principles when developing Domain-Specific Languages (DSL). To understand those principles, when developing and evaluating a DSL, is a challenge since not all design goals have the same relevance in different types of systems or DSL domains. Researchers from the Software Engineering and Human-Computer Interaction fields, for example, have mentioned in the recent past that usability or user experience evaluations usually do not use well-defined techniques to assess the quality of software products, or do not describe them accurately. Therefore, this paper will investigate whether the usability methods or techniques are still a trending topic to the DSL developers. To do that, we present an update to a Systematic Literature Review on usability evaluation that was performed in 2017. As a result, we identified that usability evaluation of DSLs is not only a trending topic but the discussions have increased in the past years. Furthermore, in this paper, we present an extension of a taxonomy on usability evaluation of DSLs. © 2021, Springer Nature Switzerland AG.},
