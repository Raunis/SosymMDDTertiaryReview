@CONFERENCE{Hamdani2018134,
author={Hamdani, M. and Butt, W.H. and Anwar, M.W. and Azam, F.},
title={A systematic literature review on Interaction Flow Modeling Language (IFML)},
journal={ACM International Conference Proceeding Series},
year={2018},
pages={134-138},
doi={10.1145/3180374.3181333},
note={cited By 12; Conference of 2nd International Conference on Management Engineering, Software Engineering and Service Sciences, ICMSS 2018 ; Conference Date: 13 January 2018 Through 15 January 2018;  Conference Code:136015},
url={https://www.scopus.com/inward/record.uri?eid=2-s2.0-85047094755&doi=10.1145%2f3180374.3181333&partnerID=40&md5=fec39e7e334f5c19ee90fdac2a4a13b2},
abstract={Design of front-end interfaces in software applications is a complex process. In this context, Interaction Flow Modeling Language (IFML) is an emerging standard introduced in 2013 by Object Management Group (OMG). In this article, a Systematic Literature Review (SLR) is performed to examine the applications of IFML. Particularly, 22 research studies (2014-2017) are identified and analyzed. Consequently, four major areas are recognized where IFML is frequently applied i.e. mobile applications (9 studies), web applications (8 studies), others (4 studies) and desktop applications (1 study). Furthermore, 9 leading IFML tools are presented i.e. Modeling (3) and model transformation (6). It has been concluded that IFML certainly simplifies the design and implementation of front-end interfaces. However, the existing IFML tools are not mature enough to be utilized for complex and large software applications. © 2018 Association for Computing Machinery.},
