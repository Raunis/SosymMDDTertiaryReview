	author = {Marcen, Ana Cristina and Iglesias, Antonio and Lapena, Raúl and Pérez, Francisca and Cetina, Carlos},
	title = {A Systematic Literature Review of Model-Driven Engineering Using Machine Learning},
	year = {2024},
