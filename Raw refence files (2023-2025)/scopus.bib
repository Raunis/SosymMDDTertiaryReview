@CONFERENCE{Morales M2024117,
	author = {Morales M, Yazmin V. and Valenzuela R, Blanca D. and Salgado, René Santaolaya and Serna, Gabriel Gonzalez and Castro-Sánchez, Noé Alejandro},
	title = {Brief State of the Art on Human-AI in Software Engineering: Impact, Ethical Challenges, and Academic Evolution},
